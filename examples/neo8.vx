// These source facts must agree with the selected target's facts. They enter
// the same request; the retired frontend's implicit target globals are gone.
[[fact(ram_bytes,physical_ram)]] ^physical_ram:#u16 = 16384;
[[fact(rom_bank_bytes,rom_window)]] ^rom_window:#u16 = 8192;

&!msx_putchar(character:#u8);

// &~ remains a materialized C function within this export's banked module.
&~mix(value:#u16) -> #u16 { value * 3 + 5 }

&^sample(value:#u16, enabled:#b) -> #u16 {
    result:#u16 = mix(value);
    enabled ? { result += 7; };
    result
}

&^lookup(index:#u8) -> #u8 {
    table:#u8[4] = [2, 3, 5, 7];
    table[index]
}

&^entry() -> #u16 {
    msx_putchar('V');
    msx_putchar('X');
    msx_putchar(13);
    msx_putchar(10);
    sample((#u16)123, 1)
}
