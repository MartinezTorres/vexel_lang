#Packet(count:#u8,data:#u8[count]);
&~extent(n:#u8)->#u8 {
    i:#u8=0;size:#u8=0;
    (i<n)!@{size+=1;i+=1;};
    size
}
#LoopPacket(count:#u8,data:#u8[extent(count)]);
state:#[#Packet(3,[1,2,3])];

&^reset(seed:#u8) {state=#Packet(3,[seed,seed+1,seed+2]);}
&^step(n:#u8)->#u16 {
    snapshot=state;
    state.data[1]+=n;
    (#u16)snapshot.data[1]+(#u16)state.data[1]
}
&^check(n:#u8)->#u8 {state.count=n;state.data[2]}
&^construct(n:#u8)->#u8 {discarded=#LoopPacket(n,[4,5,6]);7}
